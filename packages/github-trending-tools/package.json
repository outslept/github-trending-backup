{
  "name": "github-trending-tools",
  "version": "0.0.1",
  "description": "GitHub trending repositories scraper",
  "keywords": [
    "github",
    "repositories",
    "scraper",
    "trending"
  ],
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "scrape:trending": "tsx src/index.ts",
    "sync:languages": "tsx update-languages.ts",
    "publint": "pnpm dlx publint"
  },
  "dependencies": {
    "node-html-parser": "^7.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.35",
    "tsdown": "^0.22.14"
  },
  "engines": {
    "node": ">=22.20.0"
  },
  "packageManager": "pnpm@10.18.0"
}
